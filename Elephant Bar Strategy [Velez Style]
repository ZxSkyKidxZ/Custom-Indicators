//@version=5
indicator("Elephant Bar Strategy [Velez Style]", overlay=true)

// --- Inputs ---
lookback = input.int(5, "Elephant Lookback (Bars to compare)", minval=1, tooltip="How many previous bars to compare the current candle's size against.")
bodyThreshold = input.float(70.0, "Min Body % of Total Range", minval=1.0, maxval=100.0, tooltip="The percentage of the candle that must be the body (not wicks).")
sizeMult = input.float(1.5, "Size Multiplier", minval=1.0, tooltip="How much larger the candle must be compared to the average of previous candles.")
showSmas = input.bool(true, "Show SMAs")
sma1Len = input.int(20, "Fast SMA Length")
sma2Len = input.int(200, "Slow SMA Length")

// --- SMA Calculations ---
sma20 = ta.sma(close, sma1Len)
sma200 = ta.sma(close, sma2Len)

plot(showSmas ? sma20 : na, color=color.blue, title="20 SMA")
plot(showSmas ? sma200 : na, color=color.orange, title="200 SMA", linewidth=2)

// --- Elephant Bar Logic ---
// 1. Size: Significantly larger than the average of the lookback period
avgRange = ta.sma(high - low, lookback)[1]
isLarge = (high - low) > (avgRange * sizeMult)

// 2. Body Density: High body-to-wick ratio (Velez Rule: >70%)
bodySize = math.abs(open - close)
candleRange = high - low
isDense = (bodySize / candleRange) * 100 >= bodyThreshold

// 3. Identification
isBullish = close > open and isLarge and isDense
isBearish = close < open and isLarge and isDense

// --- Visuals ---
// Plot shapes below/above bars
plotshape(isBullish, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Bullish Elephant Signal")
plotshape(isBearish, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Bearish Elephant Signal")

// Color the actual bars for better visibility
barcolor(isBullish ? color.new(color.green, 0) : isBearish ? color.new(color.red, 0) : na)

// --- Alerts ---
alertcondition(isBullish, title="Bullish Elephant Alert", message="Bullish Elephant Bar Detected on {{ticker}}!")
alertcondition(isBearish, title="Bearish Elephant Alert", message="Bearish Elephant Bar Detected on {{ticker}}!")
