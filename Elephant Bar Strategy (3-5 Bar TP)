//@version=5
indicator("Elephant Bar Strategy (3-5 Bar TP)", overlay=true)

// --- Inputs ---
lookback = input.int(5, "Elephant Lookback (Bars to compare)", minval=1, tooltip="How many previous bars to compare the current candle's size against.")
bodyThreshold = input.float(70.0, "Min Body % of Total Range", minval=1.0, maxval=100.0, tooltip="The percentage of the candle that must be the body (not wicks).")
// Added step=0.1 to allow 0.1 intervals when clicking the arrows
sizeMult = input.float(1.5, "Size Multiplier", minval=1.0, step=0.1, tooltip="How much larger the candle must be compared to the average of previous candles.")
showSmas = input.bool(true, "Show SMAs")
sma1Len = input.int(20, "Fast SMA Length")
sma2Len = input.int(200, "Slow SMA Length")

// --- SMA Calculations ---
sma20 = ta.sma(close, sma1Len)
sma200 = ta.sma(close, sma2Len)

plot(showSmas ? sma20 : na, color=color.blue, title="20 SMA")
plot(showSmas ? sma200 : na, color=color.orange, title="200 SMA", linewidth=2)

// --- Elephant Bar Logic ---
// 1. Size: Significantly larger than the average of the lookback period
avgRange = ta.sma(high - low, lookback)[1]
isLarge = (high - low) > (avgRange * sizeMult)

// 2. Body Density: High body-to-wick ratio (Velez Rule: >70%)
bodySize = math.abs(open - close)
candleRange = high - low
isDense = (bodySize / candleRange) * 100 >= bodyThreshold

// 3. Identification
isBullish = close > open and isLarge and isDense
isBearish = close < open and isLarge and isDense

// --- Visuals ---
// Plot shapes below/above bars
plotshape(isBullish, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Bullish Elephant Signal")
plotshape(isBearish, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Bearish Elephant Signal")

// Color the actual bars for better visibility
barcolor(isBullish ? color.green : isBearish ? color.red : na)

// --- Oliver Velez 3-5 Bar Count TP Strategy ---
var int barsSinceBullish = na
var int barsSinceBearish = na

// Track the number of bars that have passed since the entry signal
if isBullish
    barsSinceBullish := 0
else if not na(barsSinceBullish)
    barsSinceBullish := barsSinceBullish + 1

if isBearish
    barsSinceBearish := 0
else if not na(barsSinceBearish)
    barsSinceBearish := barsSinceBearish + 1

// Define the 3-5 bar exit window (Velez Rule: Exit strictly between bars 3 and 5)
isTPWindowBullish = barsSinceBullish >= 3 and barsSinceBullish <= 5
isTPWindowBearish = barsSinceBearish >= 3 and barsSinceBearish <= 5

// Trigger TP exit markers if window conditions are active
plotshape(isTPWindowBullish, title="Bullish TP Target", style=shape.xcross, location=location.abovebar, color=color.yellow, size=size.small)
plotshape(isTPWindowBearish, title="Bearish TP Target", style=shape.xcross, location=location.belowbar, color=color.yellow, size=size.small)

// Reset trackers after the 5th bar exit window closes
if barsSinceBullish >= 5
    barsSinceBullish := na
if barsSinceBearish >= 5
    barsSinceBearish := na
